{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pet",
  "description": "Minimum capabilities for the pet window",
  "windows": ["pet"],
  "permissions": [
    "core:event:default",
    "core:window:allow-available-monitors",
    "core:window:allow-outer-position",
    "core:window:allow-set-position",
    "core:window:allow-start-dragging",
    "autostart:default",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save"
  ]
}
